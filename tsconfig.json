{
  // 仅供 IDE / tsc --noEmit 使用。包本身源码直跑：框架在 Core 子进程里以 tsx 载入 src/index.ts，
  // 本机没有类型检查工具链，验收只看 node --test。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    // 默认不写死任何路径：这份 tsconfig 只是给 IDE 用的，运行时由宿主框架的
    // src/extensions/runtime.ts 模块钩子把 cortico/<path> 映到它自己的 src/<path>，与本文件无关。
    //
    // 若要在 IDE 里跳进框架源码，把下面这段的注释去掉，并指向你自己的 Coopanion 安装目录下的
    // resources/app/build/cortico/src（不同机器路径不同，所以不预置）：
    //
    // "paths": {
    //   "cortico/*": ["<你的 Coopanion 安装目录>/resources/app/build/cortico/src/*"]
    // }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
